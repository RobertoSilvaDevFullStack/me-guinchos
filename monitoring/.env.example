# Configuração do Serviço Isolado de Monitoramento — ME Guinchos (Coolify 4.6.0 / Hostinger VPS)
# Nunca comite credenciais reais (.env é ignorado pelo Git).

NODE_ENV=production
PORT=4000
HOSTNAME=0.0.0.0

# Credenciais exclusivas do PostgreSQL 17 (rede isolada `monitoring_db_net`)
POSTGRES_DB=monitoring_db
POSTGRES_USER=monitoring_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS

# URL de conexão interna entre monitoring-api e monitoring-db
DATABASE_URL=postgresql://monitoring_user:CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS@monitoring-db:5432/monitoring_db

# Segredo criptográfico exclusivo HMAC-SHA256 compartilhado APENAS com o container Next.js (>= 32 caracteres)
MONITORING_BRIDGE_SECRET=CHANGE_ME_64_HEX_CHARS_HMAC_BRIDGE_SECRET_DO_NOT_REUSE
BRIDGE_MAX_SKEW_MS=30000

# Cadeia de Proxies Confiáveis (autenticada previamente por HMAC-SHA256):
# - 172.16.1.0/24: sub-rede `coolify` onde residem o container Next.js (que muda de IP a cada redeploy) e o `coolify-proxy` (172.16.1.3)
TRUSTED_PROXY_CIDRS=172.16.1.0/24
MAX_TRUSTED_PROXY_HOPS=2
REJECT_PRIVATE_CLIENT_IPS=true

# Origem canônica autorizada (CORS e validação CSRF de mutações administrativas)
ALLOWED_ORIGIN=https://memorettiguinchos.com.br

# Credenciais administrativas iniciais (hash scrypt gerado via utilitário `hashPassword`)
ADMIN_USERNAME=admin_memoretti
ADMIN_PASSWORD_HASH=scrypt$CHANGE_ME_SALT_HEX$CHANGE_ME_DERIVED_KEY_HEX

# Retenção automática de registros técnicos (LGPD — padrão obrigatório: 30 dias)
RETENTION_DAYS=30

# Limite de requisições de coleta por IP na janela de 60 segundos
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_EVENTS=60
